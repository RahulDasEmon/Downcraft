{
  "manifest_version": 3,
  "name": "DownCraft Integration",
  "version": "0.5.0",
  "description": "Takes over browser downloads, adds a “Download this video” button on videos and sends direct media links to the DownCraft download manager. On YouTube, Facebook, Instagram, X and other video sites it lists the formats found by yt-dlp.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "webRequest",
    "storage",
    "cookies",
    "tabs",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:19870/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "formats.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "DownCraft",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "button.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
